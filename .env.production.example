# Copy to .env.production on your Linux server. Never commit the real file.
SITE_DOMAIN=shop.example.com
TLS_EMAIL=admin@example.com
# Use long, unique values. A URL-safe database password avoids URI escaping.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_VALUE
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
STORE_COUNTRY=Pakistan
STORE_CURRENCY=PKR
ADMIN_NOTIFICATION_EMAIL=admin@example.com
EMAIL_FROM=MS Collection <admin@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RUN_WORKER=true
# Optional eligible online provider. Cash on delivery works without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional object storage; otherwise the Compose stack keeps media in a volume.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
