# Local: leave DATABASE_URL empty for persistent embedded PostgreSQL.
# For Docker: postgresql://mscollection:CHANGE_ME@localhost:5432/mscollection
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
APP_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:4000,http://127.0.0.1:4000
# Set before first seed, or use generated .data/initial-admin.txt login locally.
ADMIN_EMAIL=owner@mscollection.local
ADMIN_PASSWORD=
STORE_CURRENCY=PKR
STORE_COUNTRY=Pakistan
ADMIN_NOTIFICATION_EMAIL=
# Without SMTP, local messages are saved to ignored .data/mail/*.eml.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MS Collection <store@mscollection.local>
# Production media storage (standard AWS credential environment variables apply).
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional infrastructure; integrations are documented in docs/operations.md.
REDIS_URL=
# Online payments (enable only after merchant country/gateway confirmation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
RUN_WORKER=true

# Single-host production: enable only with a persistent .data/media volume.
LOCAL_MEDIA_STORAGE=false
# Trust exactly the nearest reverse-proxy hop when the API is private.
TRUST_PROXY=0
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
ADMIN_BASE_PATH=
# Vercel-hosted storefront: external PostgreSQL plus a public Blob store.
# Leave API_INTERNAL_URL unset on Vercel to use the integrated commerce API.
BLOB_READ_WRITE_TOKEN=
